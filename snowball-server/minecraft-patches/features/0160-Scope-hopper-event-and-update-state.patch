+    // Suppress only the notification duplicated by the hopper after this write.
+    final void snowballSetItemWithoutChangeNotification(final Container container, final int slot, final ItemStack item) {
+        final boolean previous = this.snowballSuppressChangeNotification;
+        this.snowballSuppressChangeNotification = true;
+        try {
