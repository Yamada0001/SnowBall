+    // The world policy and per-pass short circuit belong to this transfer, not the JVM.
+    static final class MoveEvents {
+        private boolean suppress;
+
+        MoveEvents(final Level level, final boolean listenersPresent) {
+            this.suppress = level.paperConfig().hopper.disableMoveEvent || !listenersPresent;
+        }
+
+        boolean shouldFire() {
+            return !this.suppress;
+        }
+
+        void afterEvent(final boolean itemRead, final boolean itemChanged) {
+            if (!itemRead && !itemChanged) {
+                this.suppress = true;
+            }
+        }
+    }
+
+    private static MoveEvents moveEvents(final Level level) {
+        return new MoveEvents(level, org.bukkit.event.inventory.InventoryMoveItemEvent.getHandlerList().hasListeners());
+    }
+
+    static void setItemWithoutDuplicateNotification(final Container container, final int slot, final ItemStack item) {
+        Container target = container;
+        int targetSlot = slot;
+        while (target instanceof net.minecraft.world.CompoundContainer compound) {
+            final int size = compound.container1.getContainerSize();
+            if (targetSlot < size) {
+                target = compound.container1;
+            } else {
+                targetSlot -= size;
+                target = compound.container2;
+            }
+        }
+        if (target instanceof BlockEntity blockEntity) {
+            blockEntity.snowballSetItemWithoutChangeNotification(container, slot, item);
+        } else {
+            container.setItem(slot, item);
+        }
+    }

