From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LeavesMC <noreply@leavesmc.org>
Date: Sun, 15 Nov 2026 12:00:00 +0800
Subject: [PATCH] Allow grindstone overstacking

Vanilla `GrindstoneMenu#computeResult` bails out to `ItemStack.EMPTY` unless
both input slots hold at most one item, so overstacked stacks (stackable
shulker boxes, cursed enchanted books) can never be disenchanted or merged.

When `modify.allow-grindstone-overstacking` is enabled the count gate is
lifted and `mergeItems` combines the real counts, clamped to
`ItemOverstackUtils#getItemStackMaxCount`. With the option off the behaviour
is byte-for-byte vanilla.

diff --git a/net/minecraft/world/inventory/GrindstoneMenu.java b/net/minecraft/world/inventory/GrindstoneMenu.java
index fd4478d..ce37b2b 100644
--- a/net/minecraft/world/inventory/GrindstoneMenu.java
+++ b/net/minecraft/world/inventory/GrindstoneMenu.java
@@ -158,7 +158,7 @@ public class GrindstoneMenu extends AbstractContainerMenu {
             return ItemStack.EMPTY;
         }
 
-        if (input.getCount() <= 1 && additional.getCount() <= 1) {
+        if (org.snowballmc.snowball.LeavesConfig.modify.allowGrindstoneOverstacking || (input.getCount() <= 1 && additional.getCount() <= 1)) { // Leaves - allow grindstone overstacking
             boolean hasBothItems = !input.isEmpty() && !additional.isEmpty();
             if (!hasBothItems) {
                 ItemStack item = !input.isEmpty() ? input : additional;
@@ -182,11 +182,20 @@ public class GrindstoneMenu extends AbstractContainerMenu {
         int remaining = remaining1 + remaining2 + durability * 5 / 100;
         int count = 1;
         if (!input.isDamageableItem()) {
-            if (input.getMaxStackSize() < 2 || !ItemStack.matches(input, additional)) {
+            // Leaves start - allow grindstone overstacking
+            if (org.snowballmc.snowball.LeavesConfig.modify.allowGrindstoneOverstacking) {
+                int maxCount = org.snowballmc.snowball.util.ItemOverstackUtils.getItemStackMaxCount(input);
+                if (maxCount < 2 || !ItemStack.isSameItemSameComponents(input, additional)) {
+                    return ItemStack.EMPTY;
+                }
+
+                count = Math.min(input.getCount() + additional.getCount(), maxCount);
+            } else if (input.getMaxStackSize() < 2 || !ItemStack.matches(input, additional)) {
                 return ItemStack.EMPTY;
+            } else {
+                count = 2;
             }
-
-            count = 2;
+            // Leaves end - allow grindstone overstacking
         }
 
         ItemStack newItem = input.copyWithCount(count);
