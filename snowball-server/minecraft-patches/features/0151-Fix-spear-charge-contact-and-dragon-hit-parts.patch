From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leaves contributors <noreply@leavesmc.org>
Date: Sat, 21 Nov 2026 18:00:36 +0800
Subject: [PATCH] Fix spear charge contact cooldown and dragon hit parts

Keep the vanilla charge conditions and track dragon contacts by parent.
Preserve the nearest hit part for damage without changing event targets.

diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 2f473522e0280af2ba561f0509b9d7934f4b989f..3431f1a1b77ab3fc641ccbc6217a7f72cb0479cc 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -88,6 +88,7 @@ import net.minecraft.world.entity.ai.attributes.AttributeSupplier;
 import net.minecraft.world.entity.ai.attributes.Attributes;
 import net.minecraft.world.entity.ai.attributes.DefaultAttributes;
 import net.minecraft.world.entity.animal.wolf.Wolf;
+import net.minecraft.world.entity.boss.enderdragon.EnderDragonPart; // Leaves - spear charge fixes
 import net.minecraft.world.entity.boss.wither.WitherBoss;
 import net.minecraft.world.entity.item.ItemEntity;
 import net.minecraft.world.entity.player.Player;
@@ -3541,6 +3542,20 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
         final boolean dealsKnockback,
         final boolean dismounts
     ) {
+        // Leaves start - spear charge fixes
+        return this.stabAttack(weaponSlot, target, baseDamage, dealsDamage, dealsKnockback, dismounts, null);
+    }
+
+    public boolean stabAttack(
+        final EquipmentSlot weaponSlot,
+        final Entity target,
+        final float baseDamage,
+        final boolean dealsDamage,
+        final boolean dealsKnockback,
+        final boolean dismounts,
+        final @Nullable EnderDragonPart hitPart
+    ) {
+        // Leaves end - spear charge fixes
         if (!(this.level() instanceof ServerLevel serverLevel)) {
             return false;
         } else {
@@ -3549,7 +3564,8 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             float postEnchantmentDamage = EnchantmentHelper.modifyDamage(serverLevel, weaponItem, target, damageSource, baseDamage);
             Vec3 oldMovement = target.getDeltaMovement();
             boolean affected = dealsKnockback;
-            boolean dealtDamage = dealsDamage && target.hurtServer(serverLevel, damageSource, postEnchantmentDamage);
+            final Entity damageTarget = hitPart != null && hitPart.parentMob == target ? hitPart : target; // Leaves - spear charge fixes
+            boolean dealtDamage = dealsDamage && damageTarget.hurtServer(serverLevel, damageSource, postEnchantmentDamage); // Leaves - spear charge fixes
             affected |= dealtDamage;
             if (dealsKnockback) {
                 this.causeExtraKnockback(target, 0.4F, oldMovement, damageSource, postEnchantmentDamage, false);
diff --git a/net/minecraft/world/entity/player/Player.java b/net/minecraft/world/entity/player/Player.java
index a7dc540905008181cc40f50edcf7079227413cec..69ecb71a6a92b18bc113e95cd3fead189d99e432 100644
--- a/net/minecraft/world/entity/player/Player.java
+++ b/net/minecraft/world/entity/player/Player.java
@@ -1313,6 +1313,16 @@ public abstract class Player extends Avatar implements ContainerUser {
     public boolean stabAttack(
         final EquipmentSlot slot, final Entity target, float baseDamage, final boolean dealsDamage, final boolean dealsKnockback, final boolean dismounts
     ) {
+        // Leaves start - spear charge fixes
+        return this.stabAttack(slot, target, baseDamage, dealsDamage, dealsKnockback, dismounts, null);
+    }
+
+    @Override
+    public boolean stabAttack(
+        final EquipmentSlot slot, final Entity target, float baseDamage, final boolean dealsDamage, final boolean dealsKnockback,
+        final boolean dismounts, final @Nullable EnderDragonPart hitPart
+    ) {
+        // Leaves end - spear charge fixes
         // Paper start - PlayerAttackEntityEvent
         boolean cannotAttack = this.cannotAttack(target); // Vanilla logic
         io.papermc.paper.event.player.PrePlayerAttackEntityEvent playerAttackEntityEvent = new io.papermc.paper.event.player.PrePlayerAttackEntityEvent(
@@ -1346,7 +1356,8 @@ public abstract class Player extends Avatar implements ContainerUser {
         }
 
         Vec3 oldMovement = target.getDeltaMovement();
-        boolean wasHurt = dealsDamage && target.hurtOrSimulate(damageSource, totalDamage);
+        final Entity damageTarget = hitPart != null && hitPart.parentMob == target ? hitPart : target; // Leaves - spear charge fixes
+        boolean wasHurt = dealsDamage && damageTarget.hurtOrSimulate(damageSource, totalDamage); // Leaves - spear charge fixes
         if (dealsKnockback) {
             this.causeExtraKnockback(target, 0.4F, oldMovement, damageSource, totalDamage, false);
             this.causeExtraKnockback(target, this.getKnockback(target, damageSource), oldMovement, damageSource, totalDamage, true);
diff --git a/net/minecraft/world/item/component/KineticWeapon.java b/net/minecraft/world/item/component/KineticWeapon.java
index a5597339d39e9f1205393b1e8dcc754534193371..6cf91806d30359540bf7e1f98d143a1468c7d2df 100644
--- a/net/minecraft/world/item/component/KineticWeapon.java
+++ b/net/minecraft/world/item/component/KineticWeapon.java
@@ -110,18 +110,47 @@ public record KineticWeapon(
             double baseMobDamage = livingEntity.getAttributeBaseValue(Attributes.ATTACK_DAMAGE);
             boolean affected = false;
 
-            for (EntityHitResult hitResult : ProjectileUtil.getHitEntitiesAlong(
-                    livingEntity, attackRange, e -> PiercingWeapon.canHitEntity(livingEntity, e), ClipContext.Block.COLLIDER
-                )
-                .<Collection<EntityHitResult>>map(a -> List.of(), e -> e)) {
+            // Leaves start - spear charge fixes
+            final boolean fixContactCooldown = org.snowballmc.snowball.LeavesConfig.fix.spearChargeContactCooldown;
+            final boolean preserveDragonHitPart = org.snowballmc.snowball.LeavesConfig.fix.spearChargeDragonHitPart;
+            final Collection<EntityHitResult> hits = ProjectileUtil.getHitEntitiesAlong(
+                livingEntity, attackRange, e -> PiercingWeapon.canHitEntity(livingEntity, e), ClipContext.Block.COLLIDER
+            ).map(a -> List.of(), e -> e);
+            java.util.Map<Entity, EntityHitResult> dragonHits = null;
+            if (preserveDragonHitPart) {
+                final Vec3 origin = livingEntity.getEyePosition();
+                for (final EntityHitResult hit : hits) {
+                    if (hit.getEntity() instanceof EnderDragonPart part) {
+                        if (dragonHits == null) {
+                            dragonHits = new java.util.IdentityHashMap<>();
+                        }
+                        final EntityHitResult previous = dragonHits.get(part.parentMob);
+                        if (previous == null || hit.getLocation().distanceToSqr(origin) < previous.getLocation().distanceToSqr(origin)) {
+                            dragonHits.put(part.parentMob, hit);
+                        }
+                    }
+                }
+            }
+
+            for (final EntityHitResult hitResult : hits) {
                 Entity otherEntity = hitResult.getEntity();
+                EnderDragonPart hitPart = null;
                 if (otherEntity instanceof EnderDragonPart dragonPart) {
                     otherEntity = dragonPart.parentMob;
+                    if (dragonHits != null) {
+                        if (dragonHits.get(otherEntity) != hitResult) {
+                            continue;
+                        }
+                        hitPart = dragonPart;
+                    }
                 }
 
                 boolean wasStabbed = livingEntity.wasRecentlyStabbed(otherEntity, this.contactCooldownTicks);
                 if (!wasStabbed) {
-                    livingEntity.rememberStabbedEntity(otherEntity);
+                    if (!fixContactCooldown) {
+                        livingEntity.rememberStabbedEntity(otherEntity);
+                    }
+                    // Leaves end - spear charge fixes
                     double targetSpeedProjection = attackerLookVector.dot(getMotion(otherEntity));
                     double relativeSpeed = Math.max(0.0, attackerSpeedProjection - targetSpeedProjection);
                     boolean dealsDismount = this.dismountConditions.isPresent()
@@ -131,8 +160,17 @@ public record KineticWeapon(
                     boolean dealsDamage = this.damageConditions.isPresent()
                         && this.damageConditions.get().test(ticksUsed, attackerSpeedProjection, relativeSpeed, actionFactor);
                     if (dealsDismount || dealsKnockback || dealsDamage) {
+                        // Leaves start - spear charge fixes
+                        if (fixContactCooldown) {
+                            livingEntity.rememberStabbedEntity(otherEntity);
+                        }
+                        // Leaves end - spear charge fixes
                         float damageDealt = (float)baseMobDamage + Mth.floor(relativeSpeed * this.damageMultiplier);
-                        affected |= livingEntity.stabAttack(equipmentSlot, otherEntity, damageDealt, dealsDamage, dealsKnockback, dealsDismount);
+                        // Leaves start - spear charge fixes
+                        affected |= hitPart == null
+                            ? livingEntity.stabAttack(equipmentSlot, otherEntity, damageDealt, dealsDamage, dealsKnockback, dealsDismount)
+                            : livingEntity.stabAttack(equipmentSlot, otherEntity, damageDealt, dealsDamage, dealsKnockback, dealsDismount, hitPart);
+                        // Leaves end - spear charge fixes
                     }
                 }
             }
