+            } else {
+                // Older tripwire behavior destroys every block before placing any snapshots.
+                final java.util.Set<BlockPos> cancelled = new java.util.HashSet<>();
+                for (final org.bukkit.craftbukkit.block.CraftBlockState state : blockList.getSnapshotBlocks()) {
+                    final BlockPos position = state.getPosition();
+                    if (newLevel.destroyBlockWithResult(position, !skipDrop.contains(position), null, Block.UPDATE_LIMIT) == DestroyBlockResult.CANCELLED) {
+                        cancelled.add(position);
+                    }
+                }
