+            }
+            return;
+        }
+        // Leaves end - propagate block destruction cancellation
+        if (interleaveDestruction) {
             if (dropResources) {
                 blockList.placeBlocks(state -> newLevel.destroyBlock(state.getPosition(), !skipDrop.contains(state.getPosition()), null));
             } else {
