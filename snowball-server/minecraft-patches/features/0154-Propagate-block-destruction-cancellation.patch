+            final boolean respectDestroyCancellation = org.snowballmc.snowball.LeavesConfig.fix.propagateBlockDestructionCancellation; // Leaves
 
             for (int x = 0; x < 3; x++) {
                 for (int z = 0; z < 3; z++) {
                     BlockPos portalBlockPos = blockPos.offset(x, 0, z);
-                    level.destroyBlock(portalBlockPos, true, null);
+                    // Leaves start - propagate block destruction cancellation
+                    if (respectDestroyCancellation) {
+                        if (level.destroyBlockWithResult(portalBlockPos, true, null, Block.UPDATE_LIMIT) == DestroyBlockResult.CANCELLED) {
+                            continue;
+                        }
+                    } else {
+                        level.destroyBlock(portalBlockPos, true, null);
+                    }
+                    // Leaves end - propagate block destruction cancellation
