     public SkeletonHorse(final EntityType<? extends SkeletonHorse> type, final Level level) {
         super(type, level);
+        if (org.snowballmc.snowball.LeavesConfig.fix.fixSkeletonHorseTrapGoal) {
+            this.goalSelector.enableGoalChangeDeferral(); // Leaves - fix skeleton horse trap goal
+        }
     }
 
     public static AttributeSupplier.Builder createAttributes() {
@@ -157,11 +160,21 @@
     public void setTrap(final boolean trap) {
         if (trap != this.isTrap) {
             this.isTrap = trap;
-            if (trap) {
-                this.goalSelector.addGoal(1, this.skeletonTrapGoal);
-            } else {
-                this.goalSelector.removeGoal(this.skeletonTrapGoal);
-            }
+            // Leaves start - fix skeleton horse trap goal
+            if (org.snowballmc.snowball.LeavesConfig.fix.fixSkeletonHorseTrapGoal) {
+                this.goalSelector.runAfterGoalIteration(() -> this.updateTrapGoalRegistration(trap));
+                return;
+            }
+            this.updateTrapGoalRegistration(trap);
+        }
+    }
+
+    private void updateTrapGoalRegistration(final boolean trap) {
+        // Leaves end - fix skeleton horse trap goal
+        if (trap) {
+            this.goalSelector.addGoal(1, this.skeletonTrapGoal);
+        } else {
+            this.goalSelector.removeGoal(this.skeletonTrapGoal);
         }
     }
 
