         }
     }
 
@@ -252,7 +252,7 @@ public class Climate {
                 this.erosion,
                 this.depth,
                 this.weirdness,
-                new Climate.Parameter(this.offset, this.offset)
+                (org.snowballmc.snowball.LeavesConfig.performance.modernfixDedupClimateParameters ? org.snowballmc.snowball.modernfix.bridge.ClimateInterner.parameter(this.offset, this.offset) : new Climate.Parameter(this.offset, this.offset))
             );
         }
     }
diff --git a/net/minecraft/world/level/block/WallBlock.java b/net/minecraft/world/level/block/WallBlock.java
