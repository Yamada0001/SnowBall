-        Map<Direction, VoxelShape> tall = Shapes.rotateHorizontal(Block.boxZ(6.0, 0.0, postHeight, 0.0, 11.0));
+        Map<Direction, VoxelShape> low = leaves$dedup
+                ? org.snowballmc.snowball.modernfix.bridge.WallShapeCaches.boxZRotated(6.0, 0.0, wallTop, 0.0, 11.0)
+                : Shapes.rotateHorizontal(Block.boxZ(6.0, 0.0, wallTop, 0.0, 11.0));
+        Map<Direction, VoxelShape> tall = leaves$dedup
+                ? org.snowballmc.snowball.modernfix.bridge.WallShapeCaches.boxZRotated(6.0, 0.0, postHeight, 0.0, 11.0)
