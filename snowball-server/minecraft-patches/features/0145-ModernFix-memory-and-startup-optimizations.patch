         return this.getShapeForEachState(state -> {
             VoxelShape shape = state.getValue(UP) ? post : Shapes.empty();
 
             for (Entry<Direction, EnumProperty<WallSide>> entry : PROPERTY_BY_DIRECTION.entrySet()) {
