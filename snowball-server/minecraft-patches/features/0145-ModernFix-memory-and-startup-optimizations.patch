From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LeavesMC <noreply@leavesmc.org>
Date: Sun, 15 Nov 2026 12:30:00 +0800
Subject: [PATCH] ModernFix memory and startup optimizations

Ports the server-relevant subset of ModernFix: shape and parameter
deduplication, a periodic flush of DataFixerUpper's internal rewrite caches,
and stronghold ring-position caching hooks (memory cache provided; the dedicated pool is not ported).

This patch is Powered by ModernFix(https://github.com/embeddedt/ModernFix)

This patch is based on the following mixins:
* "org/embeddedt/modernfix/common/mixin/perf/dedup_multi_objs/*.java"
* "org/embeddedt/modernfix/common/mixin/perf/dfu/*.java"
* "org/embeddedt/modernfix/common/mixin/perf/cache_strongholds/*.java"
By: embeddedt
As part of: ModernFix (https://github.com/embeddedt/ModernFix)
Licensed under: LGPL-3.0 (https://www.gnu.org/licenses/lgpl-3.0.html)

Only the server-relevant modules are ported; the 54 client mixins and the
modules Paper already covers (dynamic resources, registry compaction,
chunk-deadlock fix, PalettedContainer compaction) are deliberately skipped.

diff --git a/net/minecraft/util/datafix/DataFixTypes.java b/net/minecraft/util/datafix/DataFixTypes.java
index 4168626dcff36763e5354fc165044d96ca661572..28c96e8c6ab964fdf2af677ba8af4e2bc413739a 100644
--- a/net/minecraft/util/datafix/DataFixTypes.java
+++ b/net/minecraft/util/datafix/DataFixTypes.java
@@ -78,6 +78,11 @@ public enum DataFixTypes {
 
     public <T> Dynamic<T> update(final DataFixer fixerUpper, final Dynamic<T> input, final int fromVersion, final int toVersion) {
         if (this.type == null) return input; // Paper - add no-op fix for custom types until we actually need fixers for them
+        // Leaves start - modernfix: dynamic DFU
+        if (org.snowballmc.snowball.LeavesConfig.performance.modernfixDfu && fromVersion < toVersion) {
+            org.snowballmc.snowball.modernfix.bridge.DfuBlaster.kick();
+        }
+        // Leaves end - modernfix: dynamic DFU
         return fixerUpper.update(this.type, input, fromVersion, toVersion);
     }
 
diff --git a/net/minecraft/util/datafix/DataFixers.java b/net/minecraft/util/datafix/DataFixers.java
index 002042d3a57e317f8a628c889092ed37bf3dccbb..dce8a3c3a71920674522c3aea811b281683bed14 100644
--- a/net/minecraft/util/datafix/DataFixers.java
+++ b/net/minecraft/util/datafix/DataFixers.java
@@ -1746,5 +1746,10 @@ public class DataFixers {
         addFixers(fixerUpper, fileFixerUpper);
         DATA_FIXER = fixerUpper.build();
         FILE_FIXER = fileFixerUpper.build(DATA_FIXER);
+        // Leaves start - modernfix: dynamic DFU
+        if (org.snowballmc.snowball.LeavesConfig.performance.modernfixDfu) {
+            org.snowballmc.snowball.modernfix.bridge.DfuBlaster.blastMaps();
+        }
+        // Leaves end - modernfix: dynamic DFU
     }
 }
