+        // SnowBall start - BiomeSpy
+        // Identical to sampling a 1xNx1 volume and reading any row, without broadcasting the value.
+        public float snowball$sampleColumnVolume(final SamplerContext context, final DensityVolume volume) {
+            if (volume.sizeX() != 1 || volume.sizeZ() != 1 || volume.sizeY() <= 1) {
+                throw new IllegalArgumentException("Expected a multi-row column");
+            }
+            DensityVolume inputVolume = new DensityVolume(
+                1, 1, 1, volume.minBlockX(), this.y, volume.minBlockZ(),
+                volume.stepBlockX(), volume.stepBlockY(), volume.stepBlockZ()
+            );
+            try (ScopedDensityBuffer inputBuffer = context.acquireBuffer(inputVolume)) {
+                this.input.sampleVolume(context, inputBuffer, inputVolume);
+                return inputBuffer.get(0);
+            }
+        }
+        // SnowBall end - BiomeSpy
 
