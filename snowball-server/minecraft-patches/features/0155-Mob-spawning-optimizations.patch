     private boolean hasStopped = false;
     private boolean hasLoggedStop = false; // Paper - Debugging
     private final Object stopLock = new Object();
+    // SnowBall start - async natural spawn counts
+    private java.util.concurrent.@Nullable ThreadPoolExecutor naturalSpawnCountExecutor;
+
+    public final java.util.concurrent.@Nullable Executor getNaturalSpawnCountExecutor() {
+        synchronized (this.stopLock) {
+            if (this.hasStopped || !org.snowballmc.snowball.LeavesConfig.async.asyncMobSpawning.enabled) {
+                return null;
+            }
+            if (this.naturalSpawnCountExecutor == null) {
+                this.naturalSpawnCountExecutor = org.snowballmc.snowball.util.NaturalSpawnCountPipeline.newExecutor();
+            }
+            return this.naturalSpawnCountExecutor;
+        }
+    }
+    // SnowBall end - async natural spawn counts
     public final boolean hasStopped() {
         synchronized (this.stopLock) {
             return this.hasStopped;
@@ -995,6 +1010,9 @@
