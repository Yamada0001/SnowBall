+    // SnowBall start - async natural spawn counts
+    private static @Nullable MobCategory countableCategory(final Entity entity) {
+        if (entity instanceof Mob mob && (mob.isPersistenceRequired() || mob.requiresCustomPersistence())) {
+            return null;
+        }
+        final MobCategory category = entity.getType().getCategory();
+        return category == MobCategory.MISC ? null : category;
+    }
+
+    private static boolean isNaturalSpawn(final Entity entity) {
+        return entity.spawnReason == org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.NATURAL
+            || entity.spawnReason == org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.CHUNK_GEN;
+    }
+
+    private static double initialCharge(final ServerLevel level, final EntityType<?> type, final BlockPos pos) {
+        final MobSpawnSettings settings = level.environmentAttributes().getValue(EnvironmentAttributes.NATURAL_MOB_SPAWNS, pos);
+        final MobSpawnSettings.MobSpawnCost cost = settings.getMobSpawnCost(type);
+        return cost == null ? 0.0 : cost.charge();
+    }
+
+    /** Evaluate the live eligibility and spawn costs before handing only values to the worker. */
+    public static NaturalSpawnCountPipeline.Snapshot captureNaturalSpawnCounts(
+        final ServerLevel level, final NaturalSpawner.ChunkGetter chunkGetter, final boolean countAllMobs
+    ) {
+        final List<NaturalSpawnCountPipeline.Sample> samples = new ArrayList<>();
+        for (final Entity entity : level.getAllEntities()) {
+            final MobCategory category = countableCategory(entity);
+            if (category == null || (!countAllMobs && !isNaturalSpawn(entity))) {
+                continue;
+            }
+            final BlockPos pos = entity.blockPosition();
+            chunkGetter.query(ChunkPos.pack(pos), chunk -> samples.add(new NaturalSpawnCountPipeline.Sample(
+                entity.chunkPosition().pack(), category.ordinal(), pos.getX(), pos.getY(), pos.getZ(), initialCharge(level, entity.getType(), pos)
+            )));
+        }
+        return new NaturalSpawnCountPipeline.Snapshot(net.minecraft.server.level.ServerPlayer.MOBCATEGORY_TOTAL_ENUMS, samples);
+    }
+
+    /** Apply the previous tick's sampled populations to the current nearby-player map. */
+    public static NaturalSpawner.SpawnState applyNaturalSpawnCounts(
+        final int spawnableChunkCount, final ServerLevel level, final NaturalSpawnCountPipeline.Result result
+    ) {
+        final Object2IntOpenHashMap<MobCategory> mobCounts = new Object2IntOpenHashMap<>();
+        for (final MobCategory category : SPAWNING_CATEGORIES) {
+            final int count = result.count(category.ordinal());
+            if (count != 0) {
+                mobCounts.put(category, count);
+            }
+        }
+        final PotentialCalculator spawnPotential = new PotentialCalculator();
+        for (final NaturalSpawnCountPipeline.Sample sample : result.charges()) {
+            spawnPotential.addCharge(new BlockPos(sample.x(), sample.y(), sample.z()), sample.charge());
+        }
+        final ca.spottedleaf.moonrise.common.misc.NearbyPlayers nearbyPlayers = level.moonrise$getNearbyPlayers();
+        for (final NaturalSpawnCountPipeline.ChunkPopulation chunk : result.chunks()) {
+            final long key = chunk.chunkKey();
+            final ca.spottedleaf.moonrise.common.list.ReferenceList<net.minecraft.server.level.ServerPlayer> inRange = nearbyPlayers.getPlayersByChunk(
+                ChunkPos.getX(key), ChunkPos.getZ(key), ca.spottedleaf.moonrise.common.misc.NearbyPlayers.NearbyMapType.TICK_VIEW_DISTANCE
+            );
+            if (inRange != null) {
+                final net.minecraft.server.level.ServerPlayer[] players = inRange.getRawDataUnchecked();
+                for (int i = 0, size = inRange.size(); i < size; i++) {
+                    final int[] counts = players[i].mobCounts;
+                    for (int category = 0; category < counts.length; category++) {
+                        counts[category] += chunk.count(category);
+                    }
+                }
+            }
+        }
+        return new NaturalSpawner.SpawnState(spawnableChunkCount, mobCounts, spawnPotential, null);
+    }
+    // SnowBall end - async natural spawn counts
