From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LeavesMC <noreply@leavesmc.org>
Date: Sun, 15 Nov 2026 14:00:00 +0800
Subject: [PATCH] Large barrel and large ender chest

Single block containers with six rows instead of the vanilla three, no
double-block pairing involved.

- `modify.large-barrel`: a lone barrel holds 54 slots. The size
  is fixed when the block entity is constructed, so a config reload can never
  desync `items` from `getContainerSize`.
- `modify.large-ender-chest`: every player's ender chest holds 54
  slots.

Menu rows are chosen from the container's actual size rather than from the
config, so an already-open menu stays consistent even if the config is
reloaded underneath it. Hopper and comparator support needs no extra code
because the container itself is the enlarged one.

Turning either option off after storing items past slot 27 drops those items
on the next load - the storage format follows the container size.

diff --git a/net/minecraft/world/inventory/PlayerEnderChestContainer.java b/net/minecraft/world/inventory/PlayerEnderChestContainer.java
index 4df3a32..35fbe0d 100644
--- a/net/minecraft/world/inventory/PlayerEnderChestContainer.java
+++ b/net/minecraft/world/inventory/PlayerEnderChestContainer.java
@@ -26,7 +26,7 @@ public class PlayerEnderChestContainer extends SimpleContainer {
     }
 
     public PlayerEnderChestContainer(Player owner) {
-        super(27);
+        super(org.snowballmc.snowball.LeavesConfig.modify.largeEnderChest ? 54 : 27); // Leaves - large ender chest
         this.owner = owner;
         // CraftBukkit end
     }
diff --git a/net/minecraft/world/level/block/EnderChestBlock.java b/net/minecraft/world/level/block/EnderChestBlock.java
index 34e6bb7..21774ea 100644
--- a/net/minecraft/world/level/block/EnderChestBlock.java
+++ b/net/minecraft/world/level/block/EnderChestBlock.java
@@ -83,7 +83,9 @@ public class EnderChestBlock extends AbstractChestBlock<EnderChestBlockEntity> i
             // Paper start - Fix InventoryOpenEvent cancellation - moved up;
             container.setActiveChest(enderChest); // Needs to happen before ChestMenu.threeRows as it is required for opening animations
             if (level instanceof ServerLevel serverLevel && player.openMenu(
-                new SimpleMenuProvider((containerId, inventory, p) -> ChestMenu.threeRows(containerId, inventory, container), CONTAINER_TITLE)
+                new SimpleMenuProvider((containerId, inventory, p) -> container.getContainerSize() >= 54 // Leaves - large ender chest
+                    ? ChestMenu.sixRows(containerId, inventory, container) // Leaves - large ender chest
+                    : ChestMenu.threeRows(containerId, inventory, container), CONTAINER_TITLE) // Leaves - large ender chest
             ).isPresent()) {
             // Paper end - Fix InventoryOpenEvent cancellation - moved up;
                 player.awardStat(Stats.OPEN_ENDERCHEST);
diff --git a/net/minecraft/world/level/block/entity/BarrelBlockEntity.java b/net/minecraft/world/level/block/entity/BarrelBlockEntity.java
index c7fdfd4..419ad2e 100644
--- a/net/minecraft/world/level/block/entity/BarrelBlockEntity.java
+++ b/net/minecraft/world/level/block/entity/BarrelBlockEntity.java
@@ -23,6 +23,16 @@ import net.minecraft.world.level.storage.ValueInput;
 import net.minecraft.world.level.storage.ValueOutput;
 
 public class BarrelBlockEntity extends RandomizableContainerBlockEntity implements org.snowballmc.snowball.lithium.common.block.entity.inventory_change_tracking.InventoryChangeTracker, org.snowballmc.snowball.lithium.api.inventory.LithiumInventory { // Leaves - Lithium Sleeping Block Entity
+    // Leaves start - large barrel
+    /**
+     * 容器大小在实体创建时确定，之后不再跟随配置变化。
+     *
+     * <p>这样热重载配置不会让已存在的木桶的 {@code items} 长度与
+     * {@link #getContainerSize()} 不一致（那会导致读槽位越界）。</p>
+     */
+    private final int leaves$containerSize = org.snowballmc.snowball.LeavesConfig.modify.largeBarrel ? 54 : 27;
+    // Leaves end - large barrel
+
     // CraftBukkit start - add fields and methods
     public java.util.List<org.bukkit.entity.HumanEntity> transaction = new java.util.ArrayList<>();
     private int maxStack = MAX_STACK;
@@ -127,7 +137,7 @@ public class BarrelBlockEntity extends RandomizableContainerBlockEntity implemen
 
     @Override
     public int getContainerSize() {
-        return 27;
+        return this.leaves$containerSize; // Leaves - large barrel
     }
 
     @Override
@@ -148,7 +158,11 @@ public class BarrelBlockEntity extends RandomizableContainerBlockEntity implemen
 
     @Override
     protected AbstractContainerMenu createMenu(final int containerId, final Inventory inventory) {
-        return ChestMenu.threeRows(containerId, inventory, this);
+        // Leaves start - large barrel - 按本实体实际的容器大小决定行数，永远自洽
+        return this.getContainerSize() >= 54
+            ? ChestMenu.sixRows(containerId, inventory, this)
+            : ChestMenu.threeRows(containerId, inventory, this);
+        // Leaves end - large barrel
     }
 
     @Override
