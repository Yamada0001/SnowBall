+    // SnowBall start - restricted world tick pilot
+    private void snowball$initParallelWorldTicking() {
+        final ExperimentalConfig.World config = ExperimentalConfig.current().world();
+        if (!config.enabled()) {
+            return;
+        }
+        if (!this.isDedicatedServer() || this.server.getPluginManager().getPlugins().length != 0) {
+            this.snowball$worldTickStatus("inactive: requires a dedicated server with no loaded plugins");
+            return;
+        }
+        this.snowball$worldTickWorkerCount = Math.min(config.threadCount(), ParallelWorldTicker.MAX_WORLDS);
+        if (this.snowball$worldTickWorkerCount < 2) {
+            this.snowball$worldTickStatus("inactive: requires at least two workers");
+            return;
+        }
+        // Synchronize admission with the transition to stopping; do not hold this lock around any wait.
+        synchronized (this.stopLock) {
+            if (this.hasStopped || !this.running) {
+                return;
+            }
+            this.snowball$parallelWorldTickPilot = true;
+        }
+        this.snowball$worldTickStatus("inactive: waiting for a batch of at least two consecutive verified idle worlds");
+    }
+
+    private void snowball$worldTickStatus(final String state) {
+        if (!state.equals(this.snowball$worldTickState)) {
+            this.snowball$worldTickState = state;
+            LOGGER.info("Parallel world tick pilot opted in, {}", state);
+        }
+    }
+
+    private boolean snowball$isParallelWorldTickCandidate(final ServerLevel level) {
+        // No live entities can portal, select a POI in another world, or update shared player state.
+        // No loaded chunks means queued block events cannot execute or load chunks. No synchronous Bukkit
+        // events are allowed on workers, even with zero plugin listeners (weather/border below).
+        return level.players().isEmpty()
+            && !level.isHandlingTick()
+            && level.getDragonFight() == null
+            && (!level.canHaveWeather() || !level.getGameRules().get(GameRules.ADVANCE_WEATHER))
+            && level.getWorldBorder().getStatus() == BorderStatus.STATIONARY
+            && level.scheduledEvents.getEventsIds().isEmpty()
+            && level.getRaids().raidMap.isEmpty()
+            && level.moonrise$getEntityLookup().getEntityCount() == 0
+            && level.blockEntityTickers.isEmpty()
+            && level.getBlockTicks().count() == 0 && level.getFluidTicks().count() == 0
+            && level.getChunkSource().snowball$isParallelTickIdle();
+    }
+
+    private void snowball$tickLevels(final BooleanSupplier haveTime, final ProfilerFiller profiler) {
+        if (!this.snowball$parallelWorldTickPilot || !this.running) {
+            for (final ServerLevel level : this.getAllLevels()) {
+                this.snowball$tickLevel(level, haveTime, profiler);
+            }
+            return;
+        }
+
+        String blocked = null;
+        if (this.server.getPluginManager().getPlugins().length != 0) {
+            blocked = "inactive: plugins are loaded";
+        } else if (!this.playerList.getPlayers().isEmpty() || !this.botList.bots.isEmpty() || !this.debugSubscribers.enabledSubscriptions().isEmpty()) {
+            blocked = "inactive: players, bots, or debug subscribers are present";
+        } else if (org.snowballmc.snowball.LeavesConfig.modify.elytraAeronautics.enableNoChunkLoad) {
+            blocked = "inactive: elytra-aeronautics can tick detached entities";
+        } else if (this.levels.size() > ParallelWorldTicker.MAX_WORLDS) {
+            blocked = "inactive: too many loaded worlds (limit " + ParallelWorldTicker.MAX_WORLDS + ")";
+        }
+        if (blocked != null) {
+            this.snowball$worldTickStatus(blocked);
+            for (final ServerLevel level : this.getAllLevels()) {
+                this.snowball$tickLevel(level, haveTime, profiler);
+            }
+            return;
+        }
+
+        final List<ServerLevel> levels = new ArrayList<>(this.levels.values());
+        boolean ranParallel = false;
+        for (int start = 0; start < levels.size();) {
+            int end = start;
+            // Keep serial worlds in their original positions and recheck after ticking one. A
+            // preceding serial level may have changed the state of the next world.
+            while (this.running && end < levels.size() && this.snowball$isParallelWorldTickCandidate(levels.get(end))) {
+                ++end;
+            }
+            if (end - start < 2) {
+                this.snowball$tickLevel(levels.get(start++), haveTime, profiler);
+                continue;
+            }
+            if (this.snowball$worldTicker == null) {
+                final java.util.concurrent.atomic.AtomicInteger workerId = new java.util.concurrent.atomic.AtomicInteger();
+                this.snowball$worldTicker = new ParallelWorldTicker<>(this.snowball$worldTickWorkerCount, runnable ->
+                    new TickThread.WorldTickThread(runnable, "SnowBall World Tick Worker #" + workerId.incrementAndGet()));
+            }
+            final List<ServerLevel> batch = levels.subList(start, end);
+            this.snowball$worldTickStatus("active: up to " + this.snowball$worldTickWorkerCount + " workers for verified idle worlds; other worlds remain serial");
+            final boolean budget = haveTime.getAsBoolean(); // snapshot the coordinator's tick-time budget
+            profiler.push("parallelWorldBarrier");
+            try {
+                this.snowball$worldTicker.tick(batch, level -> this.snowball$tickLevel(level, () -> budget, Profiler.get()));
+            } finally {
+                profiler.pop();
+            }
+            ranParallel = true;
+            start = end;
+        }
+        if (!ranParallel) {
+            this.snowball$worldTickStatus("inactive: waiting for a batch of at least two consecutive verified idle worlds");
+        }
+    }
+
+    private ReportedException snowball$worldTickException(final ServerLevel level, final Throwable failure) {
+        final CrashReport report = CrashReport.forThrowable(failure, "Exception ticking world");
+        level.fillReportDetails(report);
+        return new ReportedException(report);
+    }
+
+    private void snowball$tickLevel(final ServerLevel level, final BooleanSupplier haveTime, final ProfilerFiller profiler) {
+        level.hasPhysicsEvent = org.bukkit.event.block.BlockPhysicsEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - BlockPhysicsEvent
+        level.hasEntityMoveEvent = io.papermc.paper.event.entity.EntityMoveEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - Add EntityMoveEvent
+        level.updateLagCompensationTick(); // Paper - lag compensation
+        profiler.push(() -> level + " " + level.dimension().identifier());
+        profiler.push("tick");
+
+        try {
+            // SnowBall start - observe world tick time
+            final ProfiledDuration worldTick = JvmProfiler.INSTANCE.onWorldTick(level.dimension(), this.tickCount);
+            boolean completed = false;
+            try {
+                level.tick(haveTime);
+                completed = true;
+            } finally {
+                if (worldTick != null) {
+                    worldTick.finish(completed);
+                }
+            }
+            // SnowBall end - observe world tick time
+        // Leaves start - update suppression crash fix
+        } catch (org.snowballmc.snowball.util.UpdateSuppressionException exception) {
+            if (ParallelWorldTicker.owns(level)) {
+                throw this.snowball$worldTickException(level, exception);
+            }
+            exception.provideLevel(level);
+            exception.consume();
+        } catch (Throwable t) {
+            if (!ParallelWorldTicker.owns(level) && t.getCause() instanceof org.snowballmc.snowball.util.UpdateSuppressionException exception) {
+                exception.provideLevel(level);
+                exception.consume();
+            }
+            // Leaves end - update suppression crash fix
+            throw this.snowball$worldTickException(level, t);
+        }
+
+        profiler.pop();
+        profiler.pop();
+        level.explosionDensityCache.clear(); // Paper - Optimize explosions
+    }
+    // SnowBall end - restricted world tick pilot
 
