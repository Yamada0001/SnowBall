+    // SnowBall start - raytrace entity culling
+    public void snowball$refreshCulling(final ServerPlayer player) {
+        if (!this.locatorBarEnabled || !this.players.contains(player) || player.isRemoved()
+            || Thread.currentThread() != player.level().getServer().getRunningThread()) {
+            return;
+        }
+        // Refresh only suppressed waypoints or existing connections with new occlusion evidence;
+        // ordinary locator updates retain their native cadence.
+        if (this.snowball$culledWaypoints.containsKey(player)) {
+            for (final WaypointTransmitter waypoint : java.util.List.copyOf(this.snowball$culledWaypoints.get(player))) {
+                if (!this.snowball$cullWaypoint(player, waypoint) && this.waypoints.contains(waypoint)) {
+                    this.createConnection(player, waypoint);
+                }
+            }
+        }
+        player.level().getServer().snowballEntityCulling.forEachOccludedWaypoint(player, waypoint -> {
+            final WaypointTransmitter.Connection existing = this.connections.get(player, waypoint);
+            if (existing != null && this.snowball$cullWaypoint(player, waypoint)) {
+                this.connections.remove(player, waypoint);
+                existing.disconnect();
+            }
+        });
+    }
+
+    private boolean snowball$cullWaypoint(final ServerPlayer player, final WaypointTransmitter waypoint) {
+        if (!org.snowballmc.snowball.experimental.culling.EntityCullingManager.enabled()) {
+            return false;
+        }
+        final boolean hidden = waypoint instanceof net.minecraft.world.entity.LivingEntity entity
+            && !WaypointTransmitter.doesSourceIgnoreReceiver(entity, player)
+            && player.level().getServer().snowballEntityCulling.shouldCull(player, entity);
+        if (hidden) {
+            this.snowball$culledWaypoints.put(player, waypoint);
+        } else {
+            this.snowball$culledWaypoints.remove(player, waypoint);
+        }
+        return hidden;
+    }
+    // SnowBall end - raytrace entity culling
+
     private void createConnection(final ServerPlayer player, final WaypointTransmitter waypoint) {
         if (player != waypoint) {
             if (isLocatorBarEnabledFor(player)) {
+                if (this.snowball$cullWaypoint(player, waypoint)) { // SnowBall - raytrace entity culling
+                    final WaypointTransmitter.Connection old = this.connections.remove(player, waypoint);
+                    if (old != null) {
+                        old.disconnect();
+                    }
+                    return;
+                }
                 waypoint.makeWaypointConnectionWith(player).ifPresentOrElse(connection -> {
                     this.connections.put(player, waypoint, connection);
                     connection.connect();
