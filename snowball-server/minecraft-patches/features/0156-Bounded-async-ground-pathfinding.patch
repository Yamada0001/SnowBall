+    // Leaves start - Bounded async pathfinding
+    private record PendingPathSearch(FlatPathSnapshot snapshot, Path previous, int previousNodeIndex, int previousNodeCount,
+                                     long submittedAt, PathSearchExecutor.SearchTask task) {
+    }
+
+    public final void recomputePathAfterBlockUpdate() {
+        final var config = LeavesConfig.async.asyncPathfinding;
+        if (config.enabled && this.getClass() == GroundPathNavigation.class && this.level instanceof ServerLevel serverLevel
+            && FlatPathSnapshot.isOwnerThread(serverLevel) && this.mob.getNavigation() == this
+            && this.targetPos != null && this.path != null && !this.path.isDone()
+            && this.level.getGameTime() - this.timeLastRecompute > MAX_TIME_RECOMPUTE && !this.pathFinder.capturesPathDebug()) {
+            if (this.leavesPendingPathSearch != null) {
+                // The owner will revalidate the whole snapshot before resuming movement.
+                return;
+            }
+            final FlatPathSnapshot snapshot = FlatPathSnapshot.capture(serverLevel, this.mob, this.targetPos, this.reachRange,
+                this.getMaxPathLength(), this.pathFinder.adjustedMaxVisitedNodes(this.maxVisitedNodesMultiplier));
+            if (snapshot != null) {
+                final var task = serverLevel.getServer().leavesPathSearch.submit(snapshot.input(), config.resolvedMaxThreads(), config.keepalive,
+                    config.resolvedQueueSize(), config.resolvedRejectPolicy() == LeavesConfig.AsyncConfig.PathfindTaskRejectPolicy.FLUSH_ALL);
+                if (task != null) {
+                    this.leavesPendingPathSearch = new PendingPathSearch(snapshot, this.path, this.path.getNextNodeIndex(),
+                        this.path.getNodeCount(), this.level.getGameTime(), task);
+                    this.hasDelayedRecomputation = false;
+                    return;
+                }
+            }
+        }
+        this.recomputePath();
+    }
+
+    private void leavesCancelPathSearch() {
+        final PendingPathSearch pending = this.leavesPendingPathSearch;
+        if (pending != null) {
+            this.leavesPendingPathSearch = null;
+            ((ServerLevel)this.level).getServer().leavesPathSearch.cancel(pending.task());
+        }
+    }
+
+    private boolean leavesWaitForPathSearch() {
+        final PendingPathSearch pending = this.leavesPendingPathSearch;
+        if (pending == null) {
+            return false;
+        }
+        final ServerLevel serverLevel = (ServerLevel)this.level;
+        if (!FlatPathSnapshot.isOwnerThread(serverLevel)) {
+            return true;
+        }
+        if (this.mob.getNavigation() != this || this.mob.level() != this.level || !this.mob.valid || !this.mob.isAlive()
+            || this.mob.isNoAi() || serverLevel.getServer().hasStopped()
+            || this.path != pending.previous() || this.path.getNextNodeIndex() != pending.previousNodeIndex()
+            || this.path.getNodeCount() != pending.previousNodeCount()) {
+            this.leavesCancelPathSearch();
+            return false;
+        }
+        final long elapsed = serverLevel.getGameTime() - pending.submittedAt();
+        if (!pending.task().completed() && elapsed >= 0 && elapsed < 2) {
+            return true;
+        }
+        final FlatPathSearch.Result result = elapsed >= 0 && elapsed <= 2 ? pending.task().completedResult() : null;
+        this.leavesCancelPathSearch();
+        if (result != null && LeavesConfig.async.asyncPathfinding.enabled && this.targetPos != null && !this.pathFinder.capturesPathDebug()
+            && pending.snapshot().matches(serverLevel, this.mob, this.targetPos, this.reachRange, this.getMaxPathLength(),
+                this.pathFinder.adjustedMaxVisitedNodes(this.maxVisitedNodesMultiplier))) {
+            this.path = pending.snapshot().makePath(result);
+            this.resetStuckTimeout();
+            this.timeLastRecompute = serverLevel.getGameTime();
+            this.hasDelayedRecomputation = false;
+        } else {
+            this.recomputePath();
+        }
+        return false;
+    }
+    // Leaves end - Bounded async pathfinding
+
     public void recomputePath() {
+        this.leavesCancelPathSearch(); // Leaves - Bounded async pathfinding
         if (this.level.getGameTime() - this.timeLastRecompute <= 20L || !this.canUpdatePath()) {
             this.hasDelayedRecomputation = true;
         } else if (this.targetPos != null) {
